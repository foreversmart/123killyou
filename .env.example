# Local development only. Never commit a real API key.
LINX_API_KEY=
LINX_API_BASE=https://xrobo.qiniu.com
# Normally use the WebSocket address returned by OTA.
LINX_WS_URL=
LINX_OTA_URL=https://xrobo.qiniuapi.com/v1/ota/
LINX_DEVICE_FILE=.local/linx/device.json
LINX_KEEPER_AGENT_ID=
# Optional initial identity; leave empty to generate a virtual MAC automatically.
# Do not change it after device.json has been created.
LINX_DEVICE_ID=
