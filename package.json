{
  "name": "nightwatch-escape-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "assets:slice": "node scripts/slice-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "go test ./...",
    "test:web": "node --experimental-strip-types --test web/tests/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write web/src web/tests scripts/check-architecture.mjs vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check web/src web/tests scripts/check-architecture.mjs vite.config.ts tsconfig.json package.json .prettierrc.json"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "^0.1.74",
    "meshoptimizer": "^1.0.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "three": "^0.180.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
